if(CNEFX_USE_SYSTEM_LIBRAW)
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(LIBRAW REQUIRED IMPORTED_TARGET libraw>=0.22)
  add_library(cnefx_libraw INTERFACE)
  target_link_libraries(cnefx_libraw INTERFACE PkgConfig::LIBRAW)
  set(CNEFX_LIBRAW_VERSION "${LIBRAW_VERSION}")
  set(CNEFX_LIBRAW_SOURCE "system")
  set(CNEFX_LIBRAW_SHA256 "")
  return()
endif()

include(FetchContent)
if(POLICY CMP0135)
  cmake_policy(SET CMP0135 NEW)
endif()
set(CNEFX_LIBRAW_VERSION "0.22.3")
set(CNEFX_LIBRAW_SOURCE "https://www.libraw.org/data/LibRaw-0.22.3.tar.gz")
set(CNEFX_LIBRAW_SHA256 "789f3c33466210a1a0907f747a97c715d21bbf4af712f257fcbbd90111b227e4")
set(CNEFX_LIBRAW_ARCHIVE "${CNEFX_LIBRAW_SOURCE}" CACHE STRING "URL or offline archive for the pinned LibRaw source")
FetchContent_Declare(cnefx_libraw_source URL "${CNEFX_LIBRAW_ARCHIVE}"
  URL_HASH "SHA256=${CNEFX_LIBRAW_SHA256}")
FetchContent_MakeAvailable(cnefx_libraw_source)

# Use the pinned upstream source manifest. Optional external codecs, LCMS,
# OpenMP, examples and SDK integrations stay disabled; LibRaw is not patched.
file(STRINGS "${cnefx_libraw_source_SOURCE_DIR}/Makefile.am" libraw_manifest)
set(libraw_collect OFF)
set(libraw_sources)
foreach(line IN LISTS libraw_manifest)
  if(line MATCHES "^lib_libraw_a_SOURCES =")
    set(libraw_collect ON)
  elseif(libraw_collect AND NOT line MATCHES "^[ \t]+src/")
    break()
  endif()
  if(libraw_collect)
    string(REGEX MATCHALL "src/[a-zA-Z0-9_/]+\\.cpp" sources "${line}")
    list(APPEND libraw_sources ${sources})
  endif()
endforeach()
list(LENGTH libraw_sources libraw_source_count)
if(libraw_source_count LESS 70 OR libraw_source_count GREATER 90)
  message(FATAL_ERROR "The pinned LibRaw source manifest was not read completely")
endif()
list(TRANSFORM libraw_sources PREPEND "${cnefx_libraw_source_SOURCE_DIR}/")
add_library(cnefx_libraw STATIC ${libraw_sources})
target_include_directories(cnefx_libraw SYSTEM PUBLIC "${cnefx_libraw_source_SOURCE_DIR}")
target_compile_features(cnefx_libraw PRIVATE cxx_std_11)
target_compile_definitions(cnefx_libraw PUBLIC LIBRAW_NODLL PRIVATE LIBRAW_BUILDLIB)
find_package(Threads REQUIRED)
target_link_libraries(cnefx_libraw PRIVATE Threads::Threads)
if(MSVC)
  target_compile_definitions(cnefx_libraw PRIVATE _CRT_SECURE_NO_WARNINGS)
  target_compile_options(cnefx_libraw PRIVATE /Gy /Gw)
else()
  target_compile_options(cnefx_libraw PRIVATE -ffunction-sections -fdata-sections)
  if(CNEFX_SANITIZE)
    target_compile_options(cnefx_libraw PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
  endif()
endif()
