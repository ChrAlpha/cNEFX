{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "npm",
    "outDir": "dist",
    "newLine": "lf",
    "types": ["node"],
    "noEmitOnError": true
  },
  "include": ["npm/**/*.ts"]
}
